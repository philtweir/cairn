{"business_data":{"resources":[{"metadata":{},"resourceinstance":{"descriptors":{},"graph_id":"58024f1e-7375-55e6-a1f3-24081bb8ffea","legacyid":"naga","name":"Naga","resourceinstanceid":"26e9021d-269b-5ea3-8554-72c3403b427b"},"tiles":[{"data":{"18517adf-8c7a-5347-8be4-59b7da015c7e":{"en":{"direction":"ltr","value":"Humanoids with the lower body, tail, and neck of snakes. Dwell in hot jungles and temples lost to time. Use cunning and hypnosis to capture other creatures to be enslaved. Gaze: A target facing the Naga is hypnotized, falling under its will. Its victims cannot be compelled to violence."}}},"nodegroup_id":"18517adf-8c7a-5347-8be4-59b7da015c7e","parenttile_id":null,"resourceinstance_id":"26e9021d-269b-5ea3-8554-72c3403b427b","sortorder":0,"tileid":"007b1d94-63c0-58a4-b2ee-8f25390faf73"},{"data":{"f8483a78-36be-575e-bede-f5f4e8c4a4de":12},"nodegroup_id":"f8483a78-36be-575e-bede-f5f4e8c4a4de","parenttile_id":null,"resourceinstance_id":"26e9021d-269b-5ea3-8554-72c3403b427b","sortorder":0,"tileid":"036e05ea-ed73-5032-9440-bfeb43526aad"},{"data":{"d642f750-8ee8-5191-8661-de1002b15f86":{"en":{"direction":"ltr","value":"Naga"}}},"nodegroup_id":"d642f750-8ee8-5191-8661-de1002b15f86","parenttile_id":null,"resourceinstance_id":"26e9021d-269b-5ea3-8554-72c3403b427b","sortorder":0,"tileid":"eacd910f-be91-5e8c-8e87-319e8ab31925"},{"data":{"9fbed355-acf1-5f3d-8b57-6d2091a606d5":1},"nodegroup_id":"9fbed355-acf1-5f3d-8b57-6d2091a606d5","parenttile_id":null,"resourceinstance_id":"26e9021d-269b-5ea3-8554-72c3403b427b","sortorder":0,"tileid":"90967a77-2515-5f38-9247-57a0faf98082"},{"data":{"313c043c-a5bd-5e13-a7d6-96a3166e047e":14},"nodegroup_id":"313c043c-a5bd-5e13-a7d6-96a3166e047e","parenttile_id":null,"resourceinstance_id":"26e9021d-269b-5ea3-8554-72c3403b427b","sortorder":0,"tileid":"b95f836b-71bb-550d-9b24-1b5a5bed21f8"},{"data":{"6ff6ead4-28ba-5d30-98d6-c722653eb86d":{"en":{"direction":"ltr","value":"sword (d6), bite (d10)"}}},"nodegroup_id":"6ff6ead4-28ba-5d30-98d6-c7