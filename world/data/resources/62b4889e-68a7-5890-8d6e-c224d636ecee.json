{"business_data":{"resources":[{"metadata":{},"resourceinstance":{"descriptors":{},"graph_id":"58024f1e-7375-55e6-a1f3-24081bb8ffea","legacyid":"manticore","name":"Manticore","resourceinstanceid":"62b4889e-68a7-5890-8d6e-c224d636ecee"},"tiles":[{"data":{"18517adf-8c7a-5347-8be4-59b7da015c7e":{"en":{"direction":"ltr","value":"Spiteful monstrosities that wear a humanoid face, a lion's body, wings of a bat, and a scorpion's tail. Dwell in mountainous regions, abandoned castles, and forgotten dungeons. Tail spikes act like darts, regrowing after a few days. A single spike is worth 150gp to a collector. Critical Damage: Target is deprived until they get a good night's sleep. Until then, they act boorish, selfish, and cruel (or more so, if that already is their nature)."}}},"nodegroup_id":"18517adf-8c7a-5347-8be4-59b7da015c7e","parenttile_id":null,"resourceinstance_id":"62b4889e-68a7-5890-8d6e-c224d636ecee","sortorder":0,"tileid":"a1603a97-2daa-5934-a6ea-e15c31c1e0ca"},{"data":{"d642f750-8ee8-5191-8661-de1002b15f86":{"en":{"direction":"ltr","value":"Manticore"}}},"nodegroup_id":"d642f750-8ee8-5191-8661-de1002b15f86","parenttile_id":null,"resourceinstance_id":"62b4889e-68a7-5890-8d6e-c224d636ecee","sortorder":0,"tileid":"f76949f9-7f99-5bf2-accb-8c650a348653"},{"data":{"6ff6ead4-28ba-5d30-98d6-c722653eb86d":{"en":{"direction":"ltr","value":"claws (d6+d6) or tail spike (d6)"}}},"nodegroup_id":"6ff6ead4-28ba-5d30-98d6-c722653eb86d","parenttile_id":null,"resourceinstance_id":"62b4889e-68a7-5890-8d6e-c224d636ecee","sortorder":0,"tileid":"0456963f-dc13-57cc-93ab-89d23c34f962"},{"data":{"e9edab76-4135-535e-87ef-9c8cfbab71d5":6},"nodegroup_id":"e9edab76-4135-535e-87ef-9c8cfbab71d5","parenttile_id":null,"resourceinstance_id":"62b4889e-68a7-5890-8d6e-c224d636ecee","sortorder":0,"tileid":"41688a66-527a-56c6-8803-cc50e1556d2b"},{"data":{"fdfdab63-f641-5740-b292-991c7400e648":15},"nodegroup_id":"fdfdab63-f641-5740-b292-991c7400e648","parenttile_id":null,"resourceinstance_id":"62b4889e-