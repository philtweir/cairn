{"business_data":{"resources":[{"metadata":{},"resourceinstance":{"descriptors":{},"graph_id":"58024f1e-7375-55e6-a1f3-24081bb8ffea","legacyid":"vampire","name":"Vampire","resourceinstanceid":"4fcab871-c2a0-5834-8b43-2e50ceb283ec"},"tiles":[{"data":{"f8483a78-36be-575e-bede-f5f4e8c4a4de":12},"nodegroup_id":"f8483a78-36be-575e-bede-f5f4e8c4a4de","parenttile_id":null,"resourceinstance_id":"4fcab871-c2a0-5834-8b43-2e50ceb283ec","sortorder":0,"tileid":"c3ca3d66-0a2e-5b2c-a0af-7c9557226416"},{"data":{"313c043c-a5bd-5e13-a7d6-96a3166e047e":16},"nodegroup_id":"313c043c-a5bd-5e13-a7d6-96a3166e047e","parenttile_id":null,"resourceinstance_id":"4fcab871-c2a0-5834-8b43-2e50ceb283ec","sortorder":0,"tileid":"9b719971-4d65-59c6-8808-4d55824aaef3"},{"data":{"9fbed355-acf1-5f3d-8b57-6d2091a606d5":1},"nodegroup_id":"9fbed355-acf1-5f3d-8b57-6d2091a606d5","parenttile_id":null,"resourceinstance_id":"4fcab871-c2a0-5834-8b43-2e50ceb283ec","sortorder":0,"tileid":"8a9a0b88-34b2-5c17-b8ba-b33cc6ed0abb"},{"data":{"18517adf-8c7a-5347-8be4-59b7da015c7e":{"en":{"direction":"ltr","value":"Charming, undead creatures that drink the blood of mortals. Act at night and sleep in a coffin during the day. Can change into a bat at will. Regeneration: A damaged vampire regains 6 HP when it bites a target that has blood. If killed, it becomes a cloud of gas and retreats to its coffin, reforming at the next nightfall. Can only be killed if exposed to sunlight or if the coffin is destroyed. Critical Damage: The vampire drains the target's essence, dealing d12 damage to WIL. If the target reaches 0 WIL this way, it dies and is raised as a thrall of the vampire."}}},"nodegroup_id":"18517adf-8c7a-5347-8be4-59b7da015c7e","parenttile_id":null,"resourceinstance_id":"4fcab871-c2a0-5834-8b43-2e50ceb283ec","sortorder":0,"tileid":"348da7e9-9f21-55a5-a718-cb0dbd5d9e2b"},{"data":{"fdfdab63-f641-5740-b292-991c7400e648":14},"nodegroup_id":"fdfdab63-f641-5740-b292-991c7400e648","parenttile_id":null,"resourceinstance_id":"4f